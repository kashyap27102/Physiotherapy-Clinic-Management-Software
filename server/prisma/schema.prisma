// Prisma schema. Release 0 covers platform, tenancy, users and permissions, sessions and audit
// (docs/ER-Diagram.md sections 3.1, 3.2, 3.5). Patient, clinical and billing tables arrive with R1.
//
// Prisma 7: the connection URL lives in prisma.config.ts, not here.
//
// Conventions (ER section 1): snake_case in the database, uuid keys, timestamptz, enums as text with CHECK
// constraints (added by hand in the migration SQL, as are the case-insensitive email index and other rules
// Prisma cannot express). Tenant-owned parents expose unique (tenant_id, id) and children use composite
// foreign keys, so a row can never point at another clinic's parent (ER section 5.2).

generator client {
  provider = "prisma-client"
  // Inside src/ so the TypeScript build can compile it. Generated, so git-ignored.
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- platform and tenancy (ER 3.1)

model Plan {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  limits        Json           @default("{}")
  featureFlags  Json           @default("{}") @map("feature_flags")
  isActive      Boolean        @default(true) @map("is_active")
  subscriptions Subscription[]

  @@map("plan")
}

model Tenant {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String
  phone               String?
  address             String?
  logoUrl             String?  @map("logo_url")
  registrationDetails String?  @map("registration_details")
  inactiveAfterDays   Int      @default(30) @map("inactive_after_days")
  /// active, suspended, cancelled
  status              String   @default("active")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  subscriptions  Subscription[]
  logo           TenantLogo?
  branches       Branch[]
  patients       Patient[]
  episodes       Episode[]
  assessments    Assessment[]
  treatmentPlans TreatmentPlan[]
  roles          Role[]
  users          UserAccount[]
  auditLogs      AuditLog[]

  @@map("tenant")
}

model Subscription {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  planId      String    @map("plan_id") @db.Uuid
  /// trial, active, suspended, cancelled
  status      String    @default("trial")
  trialEndsOn DateTime? @map("trial_ends_on") @db.Date
  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt     DateTime? @map("ended_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  plan   Plan   @relation(fields: [planId], references: [id])

  @@index([tenantId])
  @@map("subscription")
}

model Branch {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  name     String
  /// Unique per tenant; locked after the first receipt (CON-10, enforced in the application).
  code     String
  address  String?
  phone    String?
  isActive Boolean @default(true) @map("is_active")

  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  users           UserAccount[]
  patients        Patient[]
  episodesStarted Episode[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("branch")
}

// ---------------------------------------------------------------- users, roles, permissions (ER 3.2)

model Role {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  /// owner, receptionist, physiotherapist (CON-15)
  key      String
  name     String
  isSystem Boolean @default(true) @map("is_system")

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  permissions RolePermission[]
  users       UserAccount[]

  @@unique([tenantId, id])
  @@unique([tenantId, key])
  @@map("role")
}

/// Global catalogue fixed by the product (API-Requirements section 4).
model Permission {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// for example payment.record
  key         String  @unique
  description String?

  roles RolePermission[]

  @@map("permission")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permission")
}

model UserAccount {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// null for super-admin
  tenantId         String?   @map("tenant_id") @db.Uuid
  /// null for owner and super-admin
  branchId         String?   @map("branch_id") @db.Uuid
  /// null for super-admin
  roleId           String?   @map("role_id") @db.Uuid
  /// Unique case-insensitively across the platform (CON-13): index on lower(email) in the migration SQL.
  email            String
  fullName         String    @map("full_name")
  passwordHash     String    @map("password_hash")
  isSuperAdmin     Boolean   @default(false) @map("is_super_admin")
  isActive         Boolean   @default(true) @map("is_active")
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until") @db.Timestamptz(6)
  lastLoginAt      DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch Branch? @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  role   Role?   @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)

  trustedDevices      TrustedDevice[]
  otpChallenges       OtpChallenge[]
  passwordResetTokens PasswordResetToken[]
  sessions            UserSession[]
  auditLogs           AuditLog[]
  patientsCreated     Patient[]
  episodesDischarged  Episode[]
  assessmentsWritten  Assessment[]
  plansWritten        TreatmentPlan[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("user_account")
}

model TrustedDevice {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @map("token_hash")
  /// browser and device description
  label      String?
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)

  user UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tokenHash])
  @@index([userId])
  @@map("trusted_device")
}

model OtpChallenge {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)

  user UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("otp_challenge")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)

  user UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tokenHash])
  @@index([userId])
  @@map("password_reset_token")
}

/// Server-side session (httpOnly cookie carries only the opaque token; only its hash is stored).
/// Not in the ER document: added for the decided session design (server/CLAUDE.md).
model UserSession {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @map("token_hash")
  csrfToken  String    @map("csrf_token")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)

  user UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tokenHash])
  @@index([userId])
  @@map("user_session")
}

/// The clinic logo (TEN-001): one small image per clinic, kept in the database so no file storage service is needed
/// yet (OQ-5). Served only to signed-in users of the same clinic. Not in the ER document.
model TenantLogo {
  tenantId    String   @id @map("tenant_id") @db.Uuid
  contentType String   @map("content_type")
  data        Bytes
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_logo")
}

/// A clinic sign-up waiting for its email code (TEN-001 self-registration). Nothing else exists until the code is
/// verified; then the clinic, roles, owner and trial subscription are created and this row is consumed.
/// Not in the ER document. Only hashes are stored (DD-8). Case-insensitive email index in the migration SQL.
model PendingRegistration {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String
  clinicName   String    @map("clinic_name")
  fullName     String    @map("full_name")
  phone        String
  passwordHash String    @map("password_hash")
  codeHash     String    @map("code_hash")
  attempts     Int       @default(0)
  sendCount    Int       @default(1) @map("send_count")
  lastSentAt   DateTime  @default(now()) @map("last_sent_at") @db.Timestamptz(6)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  consumedAt   DateTime? @map("consumed_at") @db.Timestamptz(6)

  @@map("pending_registration")
}

// ---------------------------------------------------------------- patients (ER 3.3)

/// A person treated at the clinic (PAT-001). Belongs to the clinic, not to a branch (BR-PAT-1); the branch where they
/// were registered is recorded. Phone and name search indexes (including pg_trgm) are in the migration SQL.
model Patient {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  registeredBranchId String    @map("registered_branch_id") @db.Uuid
  fullName           String    @map("full_name")
  /// Ten digits for Indian numbers, or "+" and digits for others.
  phone              String
  /// self or guardian (US-08.5)
  phoneContactType   String    @default("self") @map("phone_contact_type")
  /// Optional; when known, the age is derived from it (BR-PAT-3).
  dateOfBirth        DateTime? @map("date_of_birth") @db.Date
  /// Age on ageRecordedOn, used when there is no date of birth.
  ageYears           Int       @map("age_years")
  ageRecordedOn      DateTime  @map("age_recorded_on") @db.Date
  /// male, female, other, undisclosed
  gender             String
  address            String?
  emergencyContact   String?   @map("emergency_contact")
  occupation         String?
  referringDoctor    String?   @map("referring_doctor")
  email              String?
  notes              String?
  /// active or inactive
  status             String    @default("active")
  createdById        String    @map("created_by") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant           Tenant      @relation(fields: [tenantId], references: [id])
  registeredBranch Branch      @relation(fields: [tenantId, registeredBranchId], references: [tenantId, id])
  createdBy        UserAccount @relation(fields: [tenantId, createdById], references: [tenantId, id])
  episodes         Episode[]

  @@unique([tenantId, id])
  @@index([tenantId, phone])
  @@index([tenantId, createdAt(sort: Desc)])
  // Partial phone search (US-09.1). The name trigram index is an expression index in the migration SQL.
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin, map: "patient_phone_trgm_idx")
  @@map("patient")
}

// ---------------------------------------------------------------- clinical (ER 3.3, CLN-001 to CLN-004)

/// One course of treatment (BR-CLN-1). At most one active episode per patient: a partial unique index in the
/// migration SQL (CON-11). Discharged episodes stay for good; a returning patient gets a new episode (BR-CLN-8).
model Episode {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  patientId       String    @map("patient_id") @db.Uuid
  startedBranchId String    @map("started_branch_id") @db.Uuid
  /// active or discharged
  status          String    @default("active")
  startedAt       DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  dischargedAt    DateTime? @map("discharged_at") @db.Timestamptz(6)
  dischargeNote   String?   @map("discharge_note")
  dischargedById  String?   @map("discharged_by") @db.Uuid

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  patient        Patient         @relation(fields: [tenantId, patientId], references: [tenantId, id])
  startedBranch  Branch          @relation(fields: [tenantId, startedBranchId], references: [tenantId, id])
  dischargedBy   UserAccount?    @relation(fields: [tenantId, dischargedById], references: [tenantId, id])
  assessments    Assessment[]
  treatmentPlans TreatmentPlan[]

  @@unique([tenantId, id])
  @@index([tenantId, patientId, startedAt(sort: Desc)])
  @@map("episode")
}

/// Append-only and versioned (BR-CLN-4): an edit inserts the next version. Insert and select only (SEC-008).
model Assessment {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  episodeId     String   @map("episode_id") @db.Uuid
  version       Int
  history       String?
  pain          String?
  rangeOfMotion String?  @map("range_of_motion")
  diagnosis     String?
  /// chief complaint, pain score and others
  extraFields   Json     @default("{}") @map("extra_fields")
  authorId      String   @map("author_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant      @relation(fields: [tenantId], references: [id])
  episode Episode     @relation(fields: [tenantId, episodeId], references: [tenantId, id])
  author  UserAccount @relation(fields: [tenantId, authorId], references: [tenantId, id])

  @@unique([episodeId, version])
  @@index([tenantId, episodeId])
  @@map("assessment")
}

/// Append-only and versioned (BR-CLN-4). The estimated cost is informational only and creates no charge (BR-CLN-5).
model TreatmentPlan {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  episodeId       String   @map("episode_id") @db.Uuid
  version         Int
  diagnosis       String?
  goals           String?
  plannedSessions Int?     @map("planned_sessions")
  /// for example 3 times a week
  frequency       String?
  therapyTypes    String?  @map("therapy_types")
  estimatedCost   Decimal? @map("estimated_cost") @db.Decimal(12, 2)
  notes           String?
  authorId        String   @map("author_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant      @relation(fields: [tenantId], references: [id])
  episode Episode     @relation(fields: [tenantId, episodeId], references: [tenantId, id])
  author  UserAccount @relation(fields: [tenantId, authorId], references: [tenantId, id])

  @@unique([episodeId, version])
  @@index([tenantId, episodeId])
  @@map("treatment_plan")
}

// ---------------------------------------------------------------- audit (ER 3.5)

/// Append-only (SEC-008): the application database role gets INSERT and SELECT only.
model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// null for platform events
  tenantId   String?  @map("tenant_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  branchId   String?  @map("branch_id") @db.Uuid
  /// for example patient.view, payment.record
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id") @db.Uuid
  /// before and after values, reasons
  details    Json?
  ipAddress  String?  @map("ip_address") @db.Inet
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   UserAccount? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, targetType, targetId])
  @@map("audit_log")
}
