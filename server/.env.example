# Copy to .env for local development. .env is git-ignored; never commit real credentials.

NODE_ENV=development
PORT=4000

# Browser origins allowed to call the API, comma-separated (the client dev server).
CORS_ORIGINS=http://localhost:5173

# Hosted development database (Render or Neon). Use TEST DATA ONLY until the legal review on data
# location is done (docs/PRD.md section 19, REG-2). Neon needs ?sslmode=require at the end.
# Leave empty to run the API without a database.
DATABASE_URL=

# Set to true when running behind a reverse proxy such as Render.
TRUST_PROXY=false

# Email delivery through Resend (OTP, password reset, invitations). Leave empty to run without email.
# Until a domain is verified, Resend only delivers from onboarding@resend.dev to the account owner's own address.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Optional overrides
# LOG_LEVEL=debug
# RATE_LIMIT_PER_MINUTE=300

# Optional: enables the tenant-isolation tests (npm test). Point at a development or CI database with TEST DATA ONLY;
# the tests create and remove their own clinics. Leave empty to skip them.
TEST_DATABASE_URL=
